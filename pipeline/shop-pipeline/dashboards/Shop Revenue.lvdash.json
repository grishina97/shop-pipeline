{
  "datasets": [
    {
      "name": "5c89770f",
      "displayName": "kpi",
      "queryLines": [
        "-- dataset: kpi — summary figures for tiles\r\n",
        "SELECT\r\n",
        "  ROUND(SUM(revenue_eur), 2)               AS revenue_eur,     -- total revenue\r\n",
        "  SUM(orders)                              AS orders,          -- total paid orders\r\n",
        "  ROUND(SUM(revenue_eur) / SUM(orders), 2) AS avg_order_eur    -- average order value\r\n",
        "FROM workspace.shop.gold_daily_revenue;\r\n"
      ]
    },
    {
      "name": "171b4f40",
      "displayName": "daily",
      "queryLines": [
        "-- dataset: daily — for daily chart and by-country chart\r\n",
        "SELECT order_date, country, orders, revenue_eur\r\n",
        "FROM workspace.shop.gold_daily_revenue;\r\n"
      ]
    },
    {
      "name": "d253088d",
      "displayName": "category",
      "queryLines": [
        "-- dataset: category — for chart by category\r\n",
        "SELECT category, orders, revenue_eur\r\n",
        "FROM workspace.shop.gold_category_revenue;"
      ]
    }
  ],
